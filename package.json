{
    "name": "black-hat-md",
    "version": "5.3.0",
    "description": "black-hat-md, a Multi Device Whatsapp Bot built by clever tech nexus to Enhance Whatsapp Communication Experience.",
    "main": "./index.js",
    "type": "commonjs",
    "scripts": {
        "dev": "node index.js",
        "setup": "npm install",
        "start": "pm2 start index.js --name black-hat-md --watch",
        "stop": "pm2 stop black-hat-md",
        "restart": "pm2 restart black-hat-md",
        "logs": "pm2 logs black-hat-md",
        "monit": "pm2 monit",
        "delete": "pm2 delete black-hat-md",
        "stash": "git stash && git stash drop",
        "dev:pretty": "node index.js | pino-pretty --colorize --levelFirst",
        "dbcheck": "node -e \"require(\\\"./black_hat/database/maintenance\\\").integrityCheck().then(r=>{console.log(JSON.stringify(r,null,2));process.exit(r.ok?0:1)}).catch(e=>{console.error(e);process.exit(1)})\"",
        "dbbackup": "node -e \"require(\\\"./black_hat/database/maintenance\\\").backupSqliteDatabase().then(x=>console.log(x)).catch(e=>{console.error(e);process.exit(1)})\""
    },
    "pkg": {
        "assets": [
            "node_modules/ffmpeg-static/ffmpeg"
        ]
    },
    "allowScripts": {
        "ffmpeg-static": "true",
        "sharp": "true"
    },
    "keywords": [
        "clevertechn",
        "black-hat-md",
        "whatsapp-bot",
        "Clever Tech Nexus"
    ],
    "author": "clevertechn",
    "license": "MIT",
    "dependencies": {
        "@hapi/boom": "*",
        "adm-zip": "*",
        "axios": "^1.2.5",
        "cheerio": "latest",
        "compression": "^1.7.4",
        "dotenv": "*",
        "express": "^4.19.2",
        "express-rate-limit": "^8.7.0",
        "ffmpeg-static": "*",
        "file-type": "17.1.6",
        "fluent-ffmpeg": "*",
        "form-data": "^4.0.1",
        "fs-extra": "^11.1.0",
        "gifted-baileys": "2.5.8",
        "gifted-btns": "^1.0.2",
        "gifted-dls": "*",
        "google-tts-api": "*",
        "helmet": "^8.1.0",
        "jimp": "*",
        "moment-timezone": "^0.5.45",
        "node-cache": "^5.1.2",
        "node-cron": "^4.2.1",
        "pino": "^7.0.5",
        "pm2": "latest",
        "prom-client": "^15.1.3",
        "proper-lockfile": "^4.1.2",
        "sequelize": "latest",
        "sharp": "latest",
        "sqlite3": "^5.1.7",
        "yt-search": "2.13.1",
        "zod": "^4.6.5",
        "pg": "^8.16.3",
        "lru-cache": "^11.0.2"
    },
    "overrides": {
        "gifted-baileys": {
            "libsignal": "6.0.0"
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/clevertechn/black-hat-md.git"
    },
    "bugs": {
        "url": "https://github.com/clevertechn/black-hat-md/issues"
    },
    "homepage": "https://github.com/clevertechn/black-hat-md#readme",
    "devDependencies": {
        "pino-pretty": "^13.1.3"
    }
}
