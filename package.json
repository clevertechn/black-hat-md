{
    "name": "black-hat-md",
    "version": "6.0.0",
    "description": "BLACK HAT-MD - A powerful multi-device WhatsApp bot built by Clever Tech Nexus to enhance communication.",
    "private": false,
    "license": "MIT",
    "author": "Clever Tech Nexus <clevertechn>",
    "contributors": [
        "Clever Tech Nexus"
    ],
    "type": "commonjs",
    "main": "./index.js",
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.0.0"
    },
    "engineStrict": true,
    "packageManager": "npm@11.19.0",
    "keywords": [
        "black-hat-md",
        "whatsapp-bot",
        "whatsapp-md",
        "baileys",
        "multi-device",
        "bot",
        "clevertechn"
    ],
    "pkg": {
        "assets": [
            "node_modules/ffmpeg-static/ffmpeg"
        ]
    },
    "allowScripts": {
        "@whiskeysockets/baileys": true,
        "ffmpeg-static": true,
        "protobufjs": true,
        "sharp": true,
        "sqlite3": true
    },
    "overrides": {
        "axios": "^1.11.0",
        "protobufjs": "^7.6.6"
    },
    "scripts": {
        "start": "node index.js",
        "dev": "node index.js",
        "dev:pretty": "node index.js | pino-pretty --colorize --levelFirst",
        "postinstall": "node scripts/ensure-native-deps.js && node scripts/patch-baileys-rc14.js || true",
        "dbcheck": "node -e \"require('./black_hat/database/maintenance').integrityCheck().then(r=>{console.log(JSON.stringify(r,null,2));process.exit(r.ok?0:1)}).catch(e=>{console.error(e);process.exit(1)})\"",
        "dbbackup": "node -e \"require('./black_hat/database/maintenance').backupSqliteDatabase().then(x=>console.log(x)).catch(e=>{console.error(e);process.exit(1)})\"",
        "lint": "node --check index.js"
    },
    "dependencies": {
        "@hapi/boom": "^10.0.1",
        "@whiskeysockets/baileys": "7.0.0-rc14",
        "adm-zip": "^0.5.16",
        "axios": "^1.11.0",
        "cheerio": "^1.1.2",
        "compression": "^1.8.1",
        "dotenv": "^16.6.1",
        "express": "^5.1.0",
        "express-rate-limit": "^8.1.0",
        "ffmpeg-static": "^5.3.0",
        "file-type": "^21.0.0",
        "fluent-ffmpeg": "^2.1.3",
        "form-data": "^4.0.4",
        "fs-extra": "^11.3.2",
        "gifted-btns": "^1.0.2",
        "gifted-dls": "^1.0.4",
        "google-tts-api": "^2.0.2",
        "helmet": "^8.1.0",
        "jimp": "^1.6.0",
        "lru-cache": "^11.2.2",
        "moment-timezone": "^0.5.48",
        "node-cache": "^5.1.2",
        "node-cron": "^4.2.1",
        "p-queue": "^8.1.1",
        "pg": "^8.16.3",
        "pino": "^10.0.0",
        "pm2": "^6.0.8",
        "prom-client": "^15.1.3",
        "proper-lockfile": "^4.1.2",
        "protobufjs": "^7.6.6",
        "sequelize": "^6.37.7",
        "sharp": "^0.34.4",
        "sqlite3": "^5.1.7",
        "yt-search": "^2.13.1",
        "zod": "^4.0.17"
    },
    "devDependencies": {
        "pino-pretty": "^13.1.3"
    }
}