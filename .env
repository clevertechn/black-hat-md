# 🔐 Your bot SESSION_ID.
# Generate your Session ID from the pairing page:
# https://session.clevertech.qzz.io/pair
#
# ⚠️ The Session ID must start with: BlackHat~
#
# If SESSION_ID is not provided, the bot will use
# PAIRING_PHONE to start the WhatsApp pairing process.
SESSION_ID=

# Postress(Get one for free from neon.tech/supabase/render)...will fallback to path: black_hat/database/local-data/ if not provided
DATABASE_URL=

# 📱 Phone number used for WhatsApp pairing as a fallback
# when SESSION_ID is not provided.
#
# Enter the number in international format without the "+"
# Example: 2557XXXXXXXX
PAIRING_PHONE=
